<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AutoMediaPlayer" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/wisteria_600</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/wisteria_100</item>
        <item name="colorOnPrimaryContainer">@color/wisteria_800</item>
        <item name="colorSecondary">@color/wisteria_500</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorAccent">@color/wisteria_600</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/wisteria_50</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/wisteria_50</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.AutoMediaPlayer" parent="Base.Theme.AutoMediaPlayer" />

    <style name="ShapeAppearance.AutoMediaPlayer.Cover" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
</resources>
