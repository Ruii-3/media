<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="640dp"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cockpit_demo"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/cockpit_demo_hint"
            android:textColor="@color/text_tertiary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/demo_focus_title"
            android:textColor="@color/wisteria_700"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_demo_duck"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/demo_nav_duck"
            android:textColor="@color/wisteria_800"
            android:textSize="16sp"
            app:backgroundTint="@color/wisteria_50"
            app:cornerRadius="14dp"
            app:strokeColor="@color/wisteria_300"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_demo_transient"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/demo_call"
            android:textColor="@color/wisteria_800"
            android:textSize="16sp"
            app:backgroundTint="@color/wisteria_50"
            app:cornerRadius="14dp"
            app:strokeColor="@color/wisteria_300"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_demo_gain"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/demo_nav_end"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/wisteria_600"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_demo_loss"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/demo_other_player"
            android:textColor="@color/wisteria_800"
            android:textSize="16sp"
            app:backgroundTint="@color/wisteria_50"
            app:cornerRadius="14dp"
            app:strokeColor="@color/wisteria_300"
            app:strokeWidth="1dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/demo_usb_title"
            android:textColor="@color/wisteria_700"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_demo_usb_insert"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/demo_usb_insert"
                android:textColor="@color/wisteria_800"
                android:textSize="16sp"
                app:backgroundTint="@color/wisteria_50"
                app:cornerRadius="14dp"
                app:strokeColor="@color/wisteria_300"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_demo_usb_remove"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/demo_usb_remove"
                android:textColor="@color/wisteria_800"
                android:textSize="16sp"
                app:backgroundTint="@color/wisteria_50"
                app:cornerRadius="14dp"
                app:strokeColor="@color/wisteria_300"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/demo_usb_note"
            android:textColor="@color/text_tertiary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/demo_multiscreen_title"
            android:textColor="@color/wisteria_700"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_demo_passenger"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/demo_open_passenger"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/wisteria_600"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_demo_close"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="@string/demo_close"
            android:textColor="@color/wisteria_700"
            android:textSize="16sp"
            app:backgroundTint="@color/wisteria_100"
            app:cornerRadius="14dp" />
    </LinearLayout>
</ScrollView>
