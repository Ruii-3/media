<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:minWidth="720dp"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/play_settings"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/play_settings_hint"
        android:textColor="@color/text_tertiary"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/rg_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_order"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:buttonTint="@color/wisteria_600"
            android:text="@string/mode_order"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <RadioButton
            android:id="@+id/rb_loop_all"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:buttonTint="@color/wisteria_600"
            android:text="@string/mode_loop_all"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <RadioButton
            android:id="@+id/rb_loop_one"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:buttonTint="@color/wisteria_600"
            android:text="@string/mode_loop_one"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <RadioButton
            android:id="@+id/rb_shuffle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:buttonTint="@color/wisteria_600"
            android:text="@string/mode_shuffle"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />
    </RadioGroup>

    <TextView
        android:id="@+id/tv_mode_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip_lavender"
        android:padding="12dp"
        android:text="@string/mode_order_desc"
        android:textColor="@color/wisteria_700"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/divider" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_favorites_only"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:buttonTint="@color/wisteria_600"
        android:text="@string/show_favorites_only"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        app:useMaterialThemeColors="true" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_done"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/settings_done"
        android:textSize="18sp"
        app:cornerRadius="16dp" />
</LinearLayout>
